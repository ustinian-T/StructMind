{
  "bsonType": "object",
  "required": ["question_id", "type", "chapter", "content", "answer"],
  "permission": {
    "read": "auth.uid != null",
    "create": "auth.role.includes('admin')",
    "update": "auth.role.includes('admin')",
    "delete": "auth.role.includes('admin')"
  },
  "properties": {
    "_id": { "description": "记录ID" },
    "question_id": {
      "bsonType": "string",
      "title": "题目编号",
      "description": "唯一题目标识，如 EXAM_0001",
      "pattern": "^[A-Z]+_\\d{4,}$"
    },
    "type": {
      "bsonType": "string",
      "title": "题型",
      "enum": ["single_choice", "multi_choice", "true_false", "fill_blank"],
      "description": "单选题/多选题/判断题/填空题"
    },
    "chapter": {
      "bsonType": "string",
      "title": "所属章节",
      "description": "如：函数与极限、导数与微分、积分学等"
    },
    "difficulty": {
      "bsonType": "int",
      "title": "难度级别",
      "enum": [1, 2, 3, 4, 5],
      "defaultValue": 3,
      "description": "1基础 2简单 3中等 4较难 5困难"
    },
    "content": {
      "bsonType": "string",
      "title": "题目内容",
      "description": "题目正文，支持数学公式（LaTeX格式）"
    },
    "options": {
      "bsonType": "array",
      "title": "选项列表",
      "description": "选择题的选项，每个选项包含key和value",
      "items": {
        "bsonType": "object",
        "required": ["key", "value"],
        "properties": {
          "key": {
            "bsonType": "string",
            "description": "选项标识，如 A, B, C, D"
          },
          "value": {
            "bsonType": "string",
            "description": "选项内容"
          }
        }
      }
    },
    "answer": {
      "bsonType": "string",
      "title": "正确答案",
      "description": "选择题填选项字母，判断题填对/错，填空题填数值或表达式"
    },
    "explanation": {
      "bsonType": "string",
      "title": "解析",
      "description": "题目解析和解题思路"
    },
    "tags": {
      "bsonType": "array",
      "title": "标签",
      "description": "分类标签，如：['极限', '洛必达法则']",
      "items": {
        "bsonType": "string"
      }
    },
    "source": {
      "bsonType": "string",
      "title": "题目来源",
      "enum": ["imported", "ai_generated", "manual"],
      "defaultValue": "imported"
    },
    "usage_count": {
      "bsonType": "int",
      "title": "使用次数",
      "defaultValue": 0
    },
    "correct_rate": {
      "bsonType": "double",
      "title": "正确率",
      "description": "全局正确率百分比",
      "minimum": 0,
      "maximum": 100,
      "defaultValue": 0
    },
    "created_at": { "bsonType": "timestamp" },
    "updated_at": { "bsonType": "timestamp" }
  }
}
