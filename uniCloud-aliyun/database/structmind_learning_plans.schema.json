{
  "bsonType": "object",
  "required": ["user_id", "title", "chapters", "exam_date", "daily_minutes", "timezone", "version", "status", "plan_data"],
  "permission": {
    "read": "doc.user_id === auth.uid || auth.role.includes('admin')",
    "create": "auth.uid != null",
    "update": "doc.user_id === auth.uid || auth.role.includes('admin')",
    "delete": "doc.user_id === auth.uid || auth.role.includes('admin')"
  },
  "properties": {
    "_id": { "description": "计划ID" },
    "user_id": {
      "bsonType": "string",
      "title": "用户ID",
      "foreignKey": "structmind_users._id"
    },
    "title": {
      "bsonType": "string",
      "title": "计划名称",
      "minLength": 1,
      "maxLength": 100,
      "description": "如：期末复习计划、考研数学一轮等"
    },
    "description": {
      "bsonType": "string",
      "title": "计划描述",
      "maxLength": 500
    },
    "exam_date": {"bsonType": "string", "title": "考试日期", "description": "YYYY-MM-DD"},
    "daily_minutes": {"bsonType": "int", "title": "每日学习分钟", "minimum": 10, "maximum": 480},
    "timezone": {"bsonType": "string", "title": "IANA时区"},
    "version": {"bsonType": "int", "title": "计划版本", "minimum": 1},
    "plan_data": {"bsonType": "object", "title": "不可变计划快照"},
    "goal": {
      "bsonType": "object",
      "title": "学习目标",
      "properties": {
        "target_accuracy": {
          "bsonType": "int",
          "title": "目标正确率(%)",
          "minimum": 0,
          "maximum": 100,
          "defaultValue": 80
        },
        "daily_questions": {
          "bsonType": "int",
          "title": "每日题量",
          "minimum": 1,
          "defaultValue": 20
        },
        "weekly_hours": {
          "bsonType": "int",
          "title": "每周学习时间(小时)",
          "minimum": 1
        }
      }
    },
    "chapters": {
      "bsonType": "array",
      "title": "章节计划",
      "items": {
        "bsonType": "object",
        "required": ["chapter", "status"],
        "properties": {
          "chapter": {
            "bsonType": "string",
            "title": "章节名称"
          },
          "order": {
            "bsonType": "int",
            "title": "学习顺序"
          },
          "status": {
            "bsonType": "string",
            "title": "学习状态",
            "enum": ["not_started", "in_progress", "completed"],
            "defaultValue": "not_started"
          },
          "target_date": {
            "bsonType": "timestamp",
            "title": "计划完成日期"
          },
          "completed_at": {
            "bsonType": "timestamp",
            "title": "实际完成日期"
          },
          "questions_attempted": {
            "bsonType": "int",
            "title": "已做题数",
            "defaultValue": 0
          },
          "questions_correct": {
            "bsonType": "int",
            "title": "正确题数",
            "defaultValue": 0
          },
          "notes": {
            "bsonType": "string",
            "title": "学习笔记",
            "maxLength": 5000
          }
        }
      }
    },
    "progress": {
      "bsonType": "int",
      "title": "总体进度(%)",
      "minimum": 0,
      "maximum": 100,
      "defaultValue": 0,
      "description": "根据完成章节比例自动计算"
    },
    "status": {
      "bsonType": "string",
      "title": "计划状态",
      "enum": ["active", "superseded", "expired", "paused", "completed", "abandoned"],
      "defaultValue": "active"
    },
    "start_date": {
      "bsonType": "timestamp",
      "title": "开始日期"
    },
    "end_date": {
      "bsonType": "timestamp",
      "title": "结束日期"
    },
    "created_at": { "bsonType": "timestamp" },
    "updated_at": { "bsonType": "timestamp" }
  }
}
