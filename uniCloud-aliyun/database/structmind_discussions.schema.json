{
  "bsonType": "object",
  "required": ["question_id", "chapter", "topic", "content"],
  "permission": {
    "read": "auth.uid != null",
    "create": "auth.role.includes('admin')",
    "update": "auth.role.includes('admin')",
    "delete": "auth.role.includes('admin')"
  },
  "properties": {
    "_id": { "description": "记录ID" },
    "question_id": {
      "bsonType": "string",
      "title": "题目编号",
      "description": "唯一题目标识，如 DISC_0001",
      "pattern": "^[A-Z]+_\\d{4,}$"
    },
    "chapter": {
      "bsonType": "string",
      "title": "所属章节"
    },
    "topic": {
      "bsonType": "string",
      "title": "讨论主题",
      "description": "讨论题的核心主题，一句话概括"
    },
    "content": {
      "bsonType": "string",
      "title": "题目内容",
      "description": "讨论题完整描述和引导问题"
    },
    "reference_points": {
      "bsonType": "array",
      "title": "参考要点",
      "description": "评分时参考的知识要点列表",
      "items": {
        "bsonType": "string"
      }
    },
    "model_answer": {
      "bsonType": "string",
      "title": "参考论述",
      "description": "AI评分时参考的答案要点"
    },
    "max_score": {
      "bsonType": "int",
      "title": "满分",
      "minimum": 1,
      "maximum": 100,
      "defaultValue": 10
    },
    "tags": {
      "bsonType": "array",
      "title": "标签",
      "items": {
        "bsonType": "string"
      }
    },
    "source": {
      "bsonType": "string",
      "title": "题目来源",
      "enum": ["imported", "ai_generated", "manual"],
      "defaultValue": "imported"
    },
    "created_at": { "bsonType": "timestamp" },
    "updated_at": { "bsonType": "timestamp" }
  }
}
