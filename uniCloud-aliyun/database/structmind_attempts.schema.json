{
  "bsonType": "object",
  "required": ["question_id", "user_answer", "is_correct"],
  "permission": {
    "read": "doc.user_id === auth.uid || auth.role.includes('admin')",
    "create": "auth.uid != null",
    "update": false,
    "delete": "auth.role.includes('admin')"
  },
  "properties": {
    "_id": { "description": "记录ID" },
    "user_id": {
      "bsonType": "string",
      "title": "用户ID",
      "foreignKey": "structmind_users._id"
    },
    "question_id": {
      "bsonType": "int",
      "title": "题目ID"
    },
    "source": {
      "bsonType": "string",
      "title": "题库来源",
      "enum": ["exam", "bank", "assignment", "ai"]
    },
    "qtype": {
      "bsonType": "string",
      "title": "题型"
    },
    "user_answer": {
      "bsonType": "string",
      "title": "用户答案"
    },
    "correct_answer": {
      "bsonType": "string",
      "title": "正确答案"
    },
    "is_correct": {
      "bsonType": "int",
      "title": "是否正确",
      "enum": [0, 1]
    },
    "created_at": { "bsonType": "timestamp" }
  }
}
