# StructMind 环境变量配置
# 复制此文件为 .env 并填写实际值

# 管理员账号（首次启动自动创建）
SM_ADMIN_ACCOUNT=tanshuhong
SM_ADMIN_PASSWORD=<请修改为强密码>

# AI 服务商 API Keys
BIGMODEL_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=

# 服务器配置
SM_HOST=127.0.0.1
SM_PORT=8765

# 安全配置
SM_TOKEN_SECRET=<请替换为随机64字符密钥>
SM_MAX_SESSION_AGE=604800

# 速率限制
SM_RATE_LIMIT_WINDOW=60
SM_RATE_LIMIT_MAX=120
SM_AUTH_RATE_LIMIT_MAX=10
