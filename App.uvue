<script setup lang="uts">
	defineOptions({
		globalData: {
			token: null as string | null,
			user: null as UTSJSONObject | null
		}
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('StructMind App Launch')
		const g = getApp().globalData

		// 恢复登录状态
		const saved = uni.getStorageSync('auth')
		if (saved) {
			try {
				const parsed = JSON.parse(saved as string)
				if (parsed) {
					g.token = parsed.token || null
					g.user = parsed.user || null
				}
			} catch (e) {
				console.log('No saved auth')
			}
		}
	})

	onAppShow(() => {
		console.log('StructMind App Show')
	})

	onAppHide(() => {
		console.log('StructMind App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		if (firstBackTime == 0) {
			uni.showToast({ title: '再按一次退出应用', position: 'bottom' })
			firstBackTime = Date.now()
			setTimeout(() => { firstBackTime = 0 }, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})
	onExit(() => { console.log('StructMind App Exit') })
	// #endif
</script>

