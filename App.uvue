		--sm-success: #3cb878;
		--sm-warning: #e89c35;
		--sm-danger: #e04a3c;
		--sm-radius: 16px;
		--sm-shadow: 0 4px 24px rgba(45, 138, 123, 0.08);
	}
	.uni-row { flex-direction: row; }
	.uni-column { flex-direction: column; }
	.sm-btn {
		display: flex; align-items: center; justify-content: center; gap: 8px;
		padding: 14px 28px; border-radius: 12px; font-size: 16px; font-weight: 600;
		border: none; cursor: pointer; transition: all 0.2s ease;
	}
	.sm-btn-primary {
		background: linear-gradient(135deg, #2d8a7b, #47b5a3);
		color: white; box-shadow: 0 4px 16px rgba(45, 138, 123, 0.3);
	}
	.sm-btn-primary:active { transform: scale(0.97); opacity: 0.9; }
	.sm-btn-ghost { background: transparent; color: #2d8a7b; border: 1.5px solid #2d8a7b; }
	.sm-input {
		width: 100%; padding: 14px 16px; border: 1.5px solid #dce5e3;
		border-radius: 12px; font-size: 16px; background: #f9fbfa;
		transition: border-color 0.2s; box-sizing: border-box;
	}
